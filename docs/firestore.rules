rules_version = '2';
// Regras de segurança do Portal da Informática — Professor Welington Laignier
// - Professor: entra com a conta Google de professor e vê/edita tudo.
// - Aluno: entra de forma anônima, escolhe a turma e digita o código de 4 números.
//   O código é conferido aqui nas regras, sem que a lista de códigos fique visível.
service cloud.firestore {
  match /databases/{database}/documents {

    function isProf() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.token.email in ['professorwelingtonlaignier@gmail.com'];
    }
    function signedIn() { return request.auth != null; }
    function acesso(id) { return get(/databases/$(database)/documents/acessos/$(id)).data; }
    function temSessao() {
      return signedIn() && exists(/databases/$(database)/documents/sessoes/$(request.auth.uid));
    }
    function sessao() { return get(/databases/$(database)/documents/sessoes/$(request.auth.uid)).data; }

    // Turmas (sem nomes de alunos) e configuração geral: qualquer um lê.
    match /turmas/{turmaId} {
      allow read: if true;
      allow write: if isProf();
    }
    match /config/{doc} {
      allow read: if true;
      allow write: if isProf();
    }

    // Código de acesso do aluno. ID do documento = "<turma>_<código>".
    // O aluno só consegue abrir o documento exato do seu código; não dá para listar.
    match /acessos/{acessoId} {
      allow get: if signedIn();
      allow list, write: if isProf();
    }

    // Cadastro completo dos alunos: só o professor.
    match /alunos/{alunoId} {
      allow read, write: if isProf();
    }

    // Sessão: liga o navegador (uid anônimo) ao aluno que digitou o código certo.
    match /sessoes/{uid} {
      allow read: if isProf() || (signedIn() && request.auth.uid == uid);
      allow create, update: if signedIn() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['acessoId', 'alunoId', 'turma', 'criadoEm'])
        && acesso(request.resource.data.acessoId).alunoId == request.resource.data.alunoId
        && acesso(request.resource.data.acessoId).turma == request.resource.data.turma
        && acesso(request.resource.data.acessoId).ativo == true;
      allow delete: if isProf() || (signedIn() && request.auth.uid == uid);
    }

    // Progresso nas missões. ID do documento = "<alunoId>_<bimestre>_<missão>".
    match /progresso/{docId} {
      allow read: if isProf()
        || (temSessao() && (resource == null || resource.data.alunoId == sessao().alunoId));
      allow create, update: if temSessao()
        && request.resource.data.alunoId == sessao().alunoId
        && request.resource.data.turma == sessao().turma
        && docId.matches(sessao().alunoId + '_.*');
      allow delete: if isProf();
    }

    // Prova do bimestre. ID = "<alunoId>_<apostila>_<tentativa>" (tentativa 1 = prova; 2 = recuperação).
    // O aluno só envia uma vez, só no Dia de prova da turma (config/prova_<turma>, ligado pelo professor)
    // e a recuperação só se o professor liberou. Depois de enviada, ninguém altera (só o professor apaga).
    function cfgProva(turma) { return get(/databases/$(database)/documents/config/$('prova_' + turma)).data; }
    match /provas/{docId} {
      allow read: if isProf()
        || (temSessao() && (resource == null || resource.data.alunoId == sessao().alunoId));
      allow create: if temSessao()
        && request.resource.data.alunoId == sessao().alunoId
        && request.resource.data.turma == sessao().turma
        && request.resource.data.tentativa in [1, 2]
        && docId == sessao().alunoId + '_' + request.resource.data.aid + '_' + string(request.resource.data.tentativa)
        && exists(/databases/$(database)/documents/config/$('prova_' + sessao().turma))
        && cfgProva(sessao().turma).aberta == true
        && (request.resource.data.tentativa == 1 || sessao().alunoId in cfgProva(sessao().turma).recuperacao);
      allow update: if false;
      allow delete: if isProf();
    }

    // Tudo o que é só do professor: registros de aula, lembretes, notas, boletins.
    match /prof/{document=**} {
      allow read, write: if isProf();
    }

    // ================= MODO EXPLORADOR (outras escolas, sem código) =================
    // Professor de cada escola: professores/{email} = { escola: "santos-dumont" } (só o Welington cria).
    function profEsc(esc) {
      return isProf() || (signedIn() && request.auth.token.email_verified == true
        && exists(/databases/$(database)/documents/professores/$(request.auth.token.email))
        && get(/databases/$(database)/documents/professores/$(request.auth.token.email)).data.escola == esc);
    }
    function expSessao() { return get(/databases/$(database)/documents/exp_sessoes/$(request.auth.uid)).data; }
    function temExpSessao() { return signedIn() && exists(/databases/$(database)/documents/exp_sessoes/$(request.auth.uid)); }

    match /professores/{email} {
      allow read: if isProf() || (signedIn() && request.auth.token.email == email);
      allow write: if isProf();
    }
    match /exp_escolas/{esc} {
      allow read: if true;
      allow write: if isProf();
    }
    // Lista pública da escola: só primeiro nome + inicial, apelido e série (para o aluno achar o nome).
    match /exp_alunos/{id} {
      allow read: if true;
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['escola', 'nome', 'apelido', 'serie', 'inicial', 'criadoEm'])
        && exists(/databases/$(database)/documents/exp_escolas/$(request.resource.data.escola))
        && existsAfter(/databases/$(database)/documents/exp_segredos/$(id))
        && !exists(/databases/$(database)/documents/exp_alunos/$(id));
      allow update, delete: if profEsc(resource.data.escola);
    }
    // Nome completo: só o professor da escola.
    match /exp_privado/{id} {
      allow read, update, delete: if profEsc(resource.data.escola);
      allow create: if signedIn()
        && !exists(/databases/$(database)/documents/exp_privado/$(id))
        && getAfter(/databases/$(database)/documents/exp_alunos/$(id)).data.escola == request.resource.data.escola;
    }
    // Bichinho secreto: ninguém lê (nem o professor precisa); só é conferido aqui.
    match /exp_segredos/{id} {
      allow create: if signedIn() && !exists(/databases/$(database)/documents/exp_segredos/$(id))
        && request.resource.data.keys().hasOnly(['bicho']);
      allow update, delete: if profEsc(get(/databases/$(database)/documents/exp_alunos/$(id)).data.escola);
    }
    match /exp_sessoes/{uid} {
      allow read: if signedIn() && request.auth.uid == uid;
      allow create, update: if signedIn() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['alunoId', 'escola', 'bicho', 'criadoEm'])
        && getAfter(/databases/$(database)/documents/exp_segredos/$(request.resource.data.alunoId)).data.bicho == request.resource.data.bicho
        && getAfter(/databases/$(database)/documents/exp_alunos/$(request.resource.data.alunoId)).data.escola == request.resource.data.escola;
      allow delete: if signedIn() && request.auth.uid == uid;
    }
    // Progresso e visitas. ID = "<alunoId>_<missão>" ou "<alunoId>_visitas".
    match /exp_progresso/{docId} {
      allow read: if profEsc(resource.data.escola)
        || (temExpSessao() && (resource == null || resource.data.alunoId == expSessao().alunoId));
      allow create, update: if temExpSessao()
        && request.resource.data.alunoId == expSessao().alunoId
        && request.resource.data.escola == expSessao().escola
        && docId.matches(expSessao().alunoId + '_.*');
      allow delete: if profEsc(resource.data.escola);
    }
  }
}
